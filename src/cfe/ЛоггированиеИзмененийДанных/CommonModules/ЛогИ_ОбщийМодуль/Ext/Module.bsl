Функция ЕстьСвойство(пОбъект, пИмяРек, пТипЗначения = Неопределено) Экспорт
    КонтрольноеЗначение     =   Новый УникальныйИдентификатор;
    Попытка
        СтруктураРеквизита  =   Новый Структура(пИмяРек, КонтрольноеЗначение);
    Исключение
        Возврат Ложь;
    КонецПопытки;
    Если
        СтруктураРеквизита.Количество() > 1
    Тогда
        Возврат Ложь;
    КонецЕсли;
    ПроверятьТип            =   ТипЗНЧ(пТипЗначения) = Тип("Тип");
    Попытка
        ЗаполнитьЗначенияСвойств(СтруктураРеквизита, пОбъект);
    Исключение
        Возврат Ложь
    КонецПопытки;
    Результат               =   Ложь;
    Значение                =   СтруктураРеквизита[пИмяРек];
    Если
        Значение <> КонтрольноеЗначение
    Тогда
        Если
            ПроверятьТип
        Тогда
            Результат       =   пТипЗначения = ТипЗНЧ(Значение);
        Иначе
            Результат       =   Истина;
        КонецЕсли;
    КонецЕсли;
    Возврат Результат;
КонецФункции

Функция ЕстьПользователь()
    Если
        ЗначениеЗаполнено(ПараметрыСеанса.ТекущийПользователь)
    Тогда
        Возврат Истина
    Иначе
        Возврат Ложь
    КонецЕсли;
КонецФункции

Функция ОбработатьОшибку(Ошибка, Источник, ЧтоИзменилось)
    Событие                                         =   "Лог. Изменение Данных";
    ТекстОшибки                                     =   СокрЛП(Ошибка.Описание) + " : " + СокрЛП(?(Ошибка.Причина = Неопределено,"", Ошибка.Причина.Описание)) + Символы.ПС
                                                    +   "Имя модуля : " + СокрЛП(Ошибка.ИмяМодуля) + Символы.ПС
                                                    +   "Номер строки : " + СокрЛП(Ошибка.НомерСтроки) + Символы.ПС
                                                    +   "Исходная строка : " + СокрЛП(Ошибка.ИсходнаяСтрока) + Символы.ПС
                                                    +   "Накопленные изменения : " + ЧтоИзменилось;
    ЗаписьЖурналаРегистрации(Событие,
                            УровеньЖурналаРегистрации.Ошибка,
                            Источник.Метаданные(),
                            Источник,
                            ТекстОшибки,
                            РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
    Возврат ТекстОшибки;
КонецФункции

Процедура ЗаписатьИзменения(ЧтоИзменилось, Источник)
    Если
        Не ЗначениеЗаполнено(ЧтоИзменилось)
    Тогда
        Возврат
    КонецЕсли;
    ТипИсточника                                    =   Строка(ТипЗнч(Источник));
    Если
        СтрНачинаетсяС(ТипИсточника,"Справочник объект:")
    Или СтрНачинаетсяС(ТипИсточника,"Документ объект:")
    Тогда
        Если
            ЕстьСвойство(Источник, "Ссылка")
        Тогда
            Если
                ЗначениеЗаполнено(Источник.Ссылка)
            Тогда
                Данные                              =   Источник.Ссылка;
            Иначе
                Данные                              =   Источник.ЭтотОбъект;
            КонецЕсли;
        КонецЕсли;
    ИначеЕсли
        СтрНачинаетсяС(ТипИсточника,"Регистр сведений набор записей:")
    Или СтрНачинаетсяС(ТипИсточника,"Регистр накопления набор записей:")
    Тогда
        Если
            ЕстьСвойство(Источник, "ЭтотОбъект")
        Тогда
            Если
                ЕстьСвойство(Источник.ЭтотОбъект, "Отбор")
            Тогда
                Если
                    ЕстьСвойство(Источник.ЭтотОбъект.Отбор, "Регистратор")
                Тогда
                    Если
                        ЕстьСвойство(Источник.ЭтотОбъект.Отбор.Регистратор, "Значение")
                    Тогда
                        Попытка
                            Данные                  =   Источник.ЭтотОбъект.Отбор.Регистратор.Значение;
                        Исключение
                            Инфо                    =   ИнформацияОбОшибке();
                            ДанныеОшибки            =   "Описание='" + Инфо.Описание +
                                                        "' ИмяМодуля='" + Инфо.ИмяМодуля +
                                                        "' НомерСтроки=" + Инфо.НомерСтроки;
                            Данные                  =   "Не удалось получить данные по причине: " + ДанныеОшибки;
                        КонецПопытки;
                    КонецЕсли;
                ИначеЕсли
                    Источник.ЭтотОбъект.Отбор.Количество()>0
                Тогда
                    Для Каждого Отбор
                    Из          Источник.ЭтотОбъект.Отбор
                    Цикл
                        Если
                            ЕстьСвойство(Отбор, "Значение")
                        Тогда
                            Если
                                ЗначениеЗаполнено(Отбор.Значение)
                            Тогда
                                ТипЗначения         =   ТипЗнч(Отбор.Значение);
                                Если
                                    Не ТипЗначения = Тип("Число")
                                И   Не ТипЗначения = Тип("Строка")
                                И   Не ТипЗначения = Тип("Дата")
                                И   Не ТипЗначения = Тип("UUID")
                                И   Не ТипЗначения = Тип("Булево")
                                И   Не ТипЗначения = Тип("Структура")
                                И   Не ТипЗначения = Тип("Соответствие")
                                И   Не ТипЗначения = Тип("Массив")
                                Тогда
                                    Данные         =   Отбор.Значение;
                                    Прервать;
                                Иначе
                                    Данные         =   "";
                                КонецЕсли;
                            КонецЕсли;
                        КонецЕсли;
                    КонецЦикла;
                КонецЕсли;
            КонецЕсли;
        Иначе
            Данные                                  =   "Неопределено";
        КонецЕсли;
    ИначеЕсли
        СтрНачинаетсяС(ТипИсточника, "Константа менеджер значения:")
    Тогда
        Данные                                      =   Источник;
    Иначе
        Данные                                      =   "Неопределено";
    КонецЕсли;
    ЗаписьЖурналаРегистрации(   "Лог. Изменение Данных",
                                УровеньЖурналаРегистрации.Информация,
                                Источник.Метаданные(),
                                Данные,
                                ЧтоИзменилось,
                                РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
КонецПроцедуры

Функция ПолучитьКолонкиТЧ(ТЧ)
    Колонки                                         =   "";
    Для Каждого Колонка
    Из          ТЧ.Колонки
    Цикл
        Если
            Не Колонка.Имя = "Вспом"
        И   Не Колонка.Имя = "НомерСтроки"
        Тогда
            Колонки                                 =   Колонки + Колонка.Имя + ",";
        КонецЕсли;
    КонецЦикла;
    Возврат Новый Структура("Массив, Строка",
                            СтрРазделить(Колонки, ",", Ложь),
                            Лев(Колонки, СтрДлина(Колонки) - 1));
КонецФункции

Функция ПолучитьИзмененияТЧ(СтараяТЧ, НоваяТЧ, ТЧИмя)
    //Текст собираем в массив: сложение строк в цикле на тексте в сотни тысяч символов занимает секунды
    Части                                           =   Новый Массив;
    Колонки                                         =   ПолучитьКолонкиТЧ(СтараяТЧ).Массив;
    Если
        0 = НоваяТЧ.Количество()
    Тогда
        Для Каждого СтрТЧ
        Из          СтараяТЧ
        Цикл
            Части.Добавить("Удалена строка табличной части " + ТЧИмя + Символы.ПС);
            Для Каждого Колонка
            Из          Колонки
            Цикл
                НовыйРеквизит                       =   Строка(СтрТЧ[Колонка]);
                Если
                    ЗначениеЗаполнено(НовыйРеквизит)
                Тогда
                    Части.Добавить("Удален реквизит ТЧ " + Колонка + ", содержащий значение "
                                                    +   НовыйРеквизит + Символы.ПС);
                КонецЕсли;
            КонецЦикла;
        КонецЦикла;
    ИначеЕсли
        0 = СтараяТЧ.Количество()
    Тогда
        Для Каждого СтрТЧ
        Из          НоваяТЧ
        Цикл
            Части.Добавить("Добавлена строка табличной части " + ТЧИмя + Символы.ПС);
            Для Каждого Колонка
            Из          Колонки
            Цикл
                УдалённыйРеквизит                   =   Строка(СтрТЧ[Колонка]);
                Если
                    ЗначениеЗаполнено(УдалённыйРеквизит)
                Тогда
                    Части.Добавить("Добавлен реквизит ТЧ " + Колонка + ", содержащий значение "
                                                    +   УдалённыйРеквизит + Символы.ПС);
                КонецЕсли;
            КонецЦикла;
        КонецЦикла;
    Иначе
        //Пары строк ищем по индексу значений новой ТЧ, а не перебором всей ТЧ на каждую строку: перебор давал
        //квадратичное время, на ТЧ в тысячи строк - минуты внутри транзакции записи. Правила сопоставления прежние.
        Индекс                                      =   ИндексСтрокТЧ(НоваяТЧ, ПолучитьКолонкиТЧ(НоваяТЧ).Массив);
        //Полностью одинаковые строки сначала снимаем парами с учётом количества: среди дублей эвристический поиск
        //дал бы ничью, и неизменённая строка попала бы в лог как удалённая и добавленная
        ОдинаковыеСтроки                            =   Новый Массив;
        Для Каждого СтрТЧ
        Из          СтараяТЧ
        Цикл
            Позиция                                 =   НайтиПозициюОдинаковойСтроки(СтрТЧ, Индекс, Колонки);
            Если
                Не -1 = Позиция
            Тогда
                ИсключитьСтрокуИзИндекса(Индекс, Позиция);
                НоваяТЧ.Удалить(Индекс.Строки[Позиция]);
                ОдинаковыеСтроки.Добавить(СтрТЧ);
            КонецЕсли;
        КонецЦикла;
        Для Каждого СтрТЧ
        Из          ОдинаковыеСтроки
        Цикл
            СтараяТЧ.Удалить(СтрТЧ);
        КонецЦикла;
        Для Каждого СтрТЧ
        Из          СтараяТЧ
        Цикл
            Позиция                                 =   НайтиПозициюПохожейСтроки(СтрТЧ, Индекс);
            Если
                -1 = Позиция
            Тогда
                //Строка была удалена
                Части.Добавить("Удалена строка табличной части " + ТЧИмя + Символы.ПС);
                Для Каждого Колонка
                Из          Колонки
                Цикл
                    УдалённоеЗначение               =   Строка(СтрТЧ[Колонка]);
                    Если
                        ЗначениеЗаполнено(УдалённоеЗначение)
                    Тогда
                        Части.Добавить("Удалён реквизит ТЧ " + Колонка + ", содержащий значение "
                                                    +   УдалённоеЗначение + Символы.ПС);
                    КонецЕсли;
                КонецЦикла;
            Иначе
                //Сравниваем старую и новую строки
                НоваяСтрока                         =   Индекс.Строки[Позиция];
                Для Каждого Колонка
                Из          Колонки
                Цикл
                    Если
                        Не СтрТЧ[Колонка] = НоваяСтрока[Колонка]
                    Тогда
                        Если
                            ЗначениеЗаполнено(Строка(СтрТЧ[Колонка]))
                        Тогда
                            НовоеЗначение           =   Строка(НоваяСтрока[Колонка]);
                            Части.Добавить("Реквизит ТЧ " + Колонка
                                                    +   " Табличной части " + ТЧИмя
                                                    +   " изменился с " + Строка(СтрТЧ[Колонка])
                                                    +   " на " + ?(ЗначениеЗаполнено(НовоеЗначение), НовоеЗначение, "пусное значение") + Символы.ПС);
                        КонецЕсли;
                    КонецЕсли;
                КонецЦикла;
                //Нашли и сравнили. Убираем найденную пару из новой ТЧ; обратно в старой ТЧ её не ищем: при равном числе
                //совпадений (например, после перенумерации идентификаторов строк) обратный поиск возвращает -1 или чужую строку
                ИсключитьСтрокуИзИндекса(Индекс, Позиция);
                НоваяТЧ.Удалить(НоваяСтрока);
            КонецЕсли;
        КонецЦикла;
        //В новой ТЧ остались только строки, которым не нашлось пары в старой, - они добавлены
        Для Каждого СтрТЧ
        Из          НоваяТЧ
        Цикл
            Части.Добавить("Добавлена строка табличной части " + ТЧИмя + Символы.ПС);
            Для Каждого Колонка
            Из          Колонки
            Цикл
                ЗначениеЭлемента                    =   Строка(СтрТЧ[Колонка]);
                Если
                    ЗначениеЗаполнено(ЗначениеЭлемента)
                Тогда
                    Части.Добавить("Добавлен реквизит ТЧ " + Колонка + ", содержащий значение "
                                                    +   ЗначениеЭлемента + Символы.ПС);
                КонецЕсли;
            КонецЦикла;
        КонецЦикла;
    КонецЕсли;
    Возврат СтрСоединить(Части);
КонецФункции

//Только для этих типов поиск значения ключом Соответствия совпадает со сравнением "=" (проверено на платформе 8.5:
//числа разной точности, строки с регистром и хвостовыми пробелами, даты, UUID, ссылки, перечисления).
//Колонки со значениями других типов сравниваются напрямую, как раньше
Функция ЗначениеДляИндекса(Значение, КэшТипов)
    ТипЗначения                                     =   ТипЗнч(Значение);
    Результат                                       =   КэшТипов[ТипЗначения];
    Если
        Результат = Неопределено
    Тогда
        Результат                                   =   ТипЗначения = Тип("Число")
                                                    Или ТипЗначения = Тип("Строка")
                                                    Или ТипЗначения = Тип("Дата")
                                                    Или ТипЗначения = Тип("Булево")
                                                    Или ТипЗначения = Тип("УникальныйИдентификатор");
        Если
            Не Результат
        Тогда
            Попытка
                Результат                           =   Метаданные.НайтиПоТипу(ТипЗначения) <> Неопределено;
            Исключение
                Результат                           =   Ложь;
            КонецПопытки;
        КонецЕсли;
        КэшТипов.Вставить(ТипЗначения, Результат);
    КонецЕсли;
    Возврат Результат;
КонецФункции

//Индекс строк ТЧ по заполненным значениям колонок. Строку обозначает позиция - её номер в ТЧ на момент
//построения индекса: найденные пары удаляются из ТЧ, текущие индексы следующих строк при этом сдвигаются,
//а позиции остаются прежними. Удалённые строки только помечаются в индексе и дальше пропускаются
Функция ИндексСтрокТЧ(ТЧ, Колонки)
    Индекс                                          =   Новый Структура;
    Индекс.Вставить("Колонки",                          Колонки);
    Индекс.Вставить("Строки",                           Новый Массив);       //позиция -> строка ТЧ
    Индекс.Вставить("Исключена",                        Новый Массив);       //позиция -> Булево
    Индекс.Вставить("Веса",                             Новый Массив);       //позиция -> число совпадений, рабочий массив поиска
    Индекс.Вставить("Позиции",                          Новый Соответствие); //колонка -> значение -> массив позиций по возрастанию
    Индекс.Вставить("Осталось",                         Новый Соответствие); //колонка -> значение -> число неисключённых строк
    Индекс.Вставить("БезИндекса",                       Новый Соответствие); //колонка -> Истина, если в ней есть значения других типов
    Индекс.Вставить("ОсталосьСтрок",                    ТЧ.Количество());
    Индекс.Вставить("КэшТипов",                         Новый Соответствие);
    Для Каждого Колонка
    Из          Колонки
    Цикл
        Индекс.Позиции.Вставить(Колонка, Новый Соответствие);
        Индекс.Осталось.Вставить(Колонка, Новый Соответствие);
    КонецЦикла;
    Для Каждого СтрТЧ
    Из          ТЧ
    Цикл
        Позиция                                     =   Индекс.Строки.Количество();
        Индекс.Строки.Добавить(СтрТЧ);
        Индекс.Исключена.Добавить(Ложь);
        Индекс.Веса.Добавить(0);
        Для Каждого Колонка
        Из          Колонки
        Цикл
            Значение                                =   СтрТЧ[Колонка];
            Если
                Не ЗначениеЗаполнено(Значение)
            Тогда
                Продолжить;
            КонецЕсли;
            Если
                Не ЗначениеДляИндекса(Значение, Индекс.КэшТипов)
            Тогда
                Индекс.БезИндекса.Вставить(Колонка, Истина);
                Продолжить;
            КонецЕсли;
            ПозицииКолонки                          =   Индекс.Позиции[Колонка];
            ОсталосьКолонки                         =   Индекс.Осталось[Колонка];
            ПозицииЗначения                         =   ПозицииКолонки[Значение];
            Если
                ПозицииЗначения = Неопределено
            Тогда
                ПозицииЗначения                     =   Новый Массив;
                ПозицииКолонки.Вставить(Значение, ПозицииЗначения);
                ОсталосьКолонки.Вставить(Значение, 0);
            КонецЕсли;
            ПозицииЗначения.Добавить(Позиция);
            ОсталосьКолонки.Вставить(Значение, ОсталосьКолонки[Значение] + 1);
        КонецЦикла;
    КонецЦикла;
    Возврат Индекс;
КонецФункции

Процедура ИсключитьСтрокуИзИндекса(Индекс, Позиция)
    Индекс.Исключена[Позиция]                       =   Истина;
    Индекс.ОсталосьСтрок                            =   Индекс.ОсталосьСтрок - 1;
    СтрТЧ                                           =   Индекс.Строки[Позиция];
    Для Каждого Колонка
    Из          Индекс.Колонки
    Цикл
        Значение                                    =   СтрТЧ[Колонка];
        Если
            ЗначениеЗаполнено(Значение)
        И   ЗначениеДляИндекса(Значение, Индекс.КэшТипов)
        Тогда
            ОсталосьКолонки                         =   Индекс.Осталось[Колонка];
            ОсталосьКолонки.Вставить(Значение, ОсталосьКолонки[Значение] - 1);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

//Можно ли искать значение колонки по индексу: колонка проиндексирована целиком и значение подходящего типа
Функция ИскатьПоИндексу(Индекс, Колонка, Значение)
    Возврат Не Индекс.БезИндекса[Колонка] = Истина
        И   Не Индекс.Позиции[Колонка] = Неопределено
        И   ЗначениеДляИндекса(Значение, Индекс.КэшТипов);
КонецФункции

Функция СтрокиОдинаковы(СНайти, СтрТЧ, Колонки)
    Для Каждого Колонка
    Из          Колонки
    Цикл
        Если
            Не СНайти[Колонка] = СтрТЧ[Колонка]
        Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

//Позиция первой по порядку в ТЧ неисключённой строки, равной СНайти во всех колонках, или -1.
//Одинаковая строка обязана совпасть с СНайти в каждой заполненной колонке, поэтому кандидатов берём из самого
//короткого списка индекса по значениям СНайти; окончательно строки сравниваются "=" по всем колонкам, как раньше
Функция НайтиПозициюОдинаковойСтроки(СНайти, Индекс, Колонки)
    Кандидаты                                       =   Неопределено;
    ЧислоКандидатов                                 =   0;
    Для Каждого Колонка
    Из          Колонки
    Цикл
        Значение                                    =   СНайти[Колонка];
        Если
            Не ЗначениеЗаполнено(Значение)
        Или Не ИскатьПоИндексу(Индекс, Колонка, Значение)
        Тогда
            Продолжить;
        КонецЕсли;
        Осталось                                    =   Индекс.Осталось[Колонка][Значение];
        Если
            Осталось = Неопределено
        Или Осталось = 0
        Тогда
            Возврат -1;
        КонецЕсли;
        Если
            Кандидаты = Неопределено
        Или Осталось < ЧислоКандидатов
        Тогда
            Кандидаты                               =   Индекс.Позиции[Колонка][Значение];
            ЧислоКандидатов                         =   Осталось;
        КонецЕсли;
    КонецЦикла;
    Если
        Кандидаты = Неопределено
    Тогда
        Для Позиция = 0 По Индекс.Строки.ВГраница()
        Цикл
            Если
                Не Индекс.Исключена[Позиция]
            И   СтрокиОдинаковы(СНайти, Индекс.Строки[Позиция], Колонки)
            Тогда
                Возврат Позиция;
            КонецЕсли;
        КонецЦикла;
    Иначе
        Для Каждого Позиция
        Из          Кандидаты
        Цикл
            Если
                Не Индекс.Исключена[Позиция]
            И   СтрокиОдинаковы(СНайти, Индекс.Строки[Позиция], Колонки)
            Тогда
                Возврат Позиция;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Возврат -1;
КонецФункции

Функция ЗначенияРавныИЗаполнены(Значение, ЗначениеСтроки)
    Возврат ЗначениеЗаполнено(ЗначениеСтроки) И Значение = ЗначениеСтроки;
КонецФункции

Процедура ДобавитьВес(Веса, Позиция, Затронутые)
    Если
        Веса[Позиция] = 0
    Тогда
        Затронутые.Добавить(Позиция);
    КонецЕсли;
    Веса[Позиция]                                   =   Веса[Позиция] + 1;
КонецПроцедуры

//Выбор пары по весам - те же правила, что у прежнего перебора с сортировкой: строка с наибольшим весом,
//при ничьей лидеров -1; если осталась одна строка - она, когда её вес больше нуля.
//Вес строки, которой нет в Затронутые, равен ВесНезатронутых. Веса затронутых строк обнуляются
Функция ВыбратьПоВесам(Индекс, Затронутые, ВесНезатронутых)
    Веса                                            =   Индекс.Веса;
    Лучшая                                          =   -1;
    Макс1                                           =   -1;
    Макс2                                           =   -1;
    Для Каждого Позиция
    Из          Затронутые
    Цикл
        Вес                                         =   ВесНезатронутых + Веса[Позиция];
        Веса[Позиция]                               =   0;
        Если
            Вес > Макс1
        Тогда
            Макс2                                   =   Макс1;
            Макс1                                   =   Вес;
            Лучшая                                  =   Позиция;
        ИначеЕсли
            Вес > Макс2
        Тогда
            Макс2                                   =   Вес;
        КонецЕсли;
    КонецЦикла;
    Для Сч = 1 По Мин(Индекс.ОсталосьСтрок - Затронутые.Количество(), 2)
    Цикл
        Если
            ВесНезатронутых > Макс1
        Тогда
            Макс2                                   =   Макс1;
            Макс1                                   =   ВесНезатронутых;
            Лучшая                                  =   -1;
        ИначеЕсли
            ВесНезатронутых > Макс2
        Тогда
            Макс2                                   =   ВесНезатронутых;
        КонецЕсли;
    КонецЦикла;
    Если
        Индекс.ОсталосьСтрок = 1
    Тогда
        Если
            Макс1 <= 0
        Тогда
            Возврат -1;
        КонецЕсли;
        Если
            Лучшая = -1
        Тогда
            //Единственная оставшаяся строка не затронута - ищем её позицию
            Лучшая                                  =   Индекс.Исключена.Найти(Ложь);
        КонецЕсли;
        Возврат Лучшая;
    КонецЕсли;
    Если
        Макс1 = Макс2
    Тогда
        Возврат -1;
    КонецЕсли;
    Возврат Лучшая;
КонецФункции

//Пара для изменённой строки: неисключённая строка с наибольшим числом колонок, где значения СНайти и строки
//заполнены и равны (см. ВыбратьПоВесам). Сначала веса считаются только по коротким спискам индекса, а колонки
//с длинными списками (одно значение у многих строк: месяц, вид налога) проверяются напрямую у затронутых строк.
//Строка вне коротких списков набирает не больше, чем колонок с длинными списками; если лидер набрал больше,
//исход тот же, что при полном подсчёте. Иначе (обычно это действительно удалённая строка) считаем полностью
Функция НайтиПозициюПохожейСтроки(СНайти, Индекс)
    Если
        Индекс.ОсталосьСтрок = 0
    Тогда
        Возврат -1;
    КонецЕсли;
    ДлинаКороткогоСписка                            =   32;
    Веса                                            =   Индекс.Веса;
    Затронутые                                      =   Новый Массив;
    ДлинныеКолонки                                  =   Новый Массив;
    Для Каждого Колонка
    Из          Индекс.Колонки
    Цикл
        Значение                                    =   СНайти[Колонка];
        Если
            Не ЗначениеЗаполнено(Значение)
        Тогда
            Продолжить;
        КонецЕсли;
        Если
            Не ИскатьПоИндексу(Индекс, Колонка, Значение)
        Тогда
            ДлинныеКолонки.Добавить(Колонка);
            Продолжить;
        КонецЕсли;
        Осталось                                    =   Индекс.Осталось[Колонка][Значение];
        Если
            Осталось = Неопределено
        Или Осталось = 0
        Тогда
            Продолжить;
        КонецЕсли;
        Если
            Осталось > ДлинаКороткогоСписка
        Тогда
            ДлинныеКолонки.Добавить(Колонка);
            Продолжить;
        КонецЕсли;
        Для Каждого Позиция
        Из          Индекс.Позиции[Колонка][Значение]
        Цикл
            Если
                Не Индекс.Исключена[Позиция]
            Тогда
                ДобавитьВес(Веса, Позиция, Затронутые);
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Если
        Индекс.ОсталосьСтрок > 1
    Тогда
        Лидер                                       =   -1;
        Второй                                      =   -1;
        Для Каждого Позиция
        Из          Затронутые
        Цикл
            Вес                                     =   Веса[Позиция];
            СтрТЧ                                   =   Индекс.Строки[Позиция];
            Для Каждого Колонка
            Из          ДлинныеКолонки
            Цикл
                Если
                    ЗначенияРавныИЗаполнены(СНайти[Колонка], СтрТЧ[Колонка])
                Тогда
                    Вес                             =   Вес + 1;
                КонецЕсли;
            КонецЦикла;
            Если
                Вес > Лидер
            Тогда
                Второй                              =   Лидер;
                Лидер                               =   Вес;
                ЛучшаяПозиция                       =   Позиция;
            ИначеЕсли
                Вес > Второй
            Тогда
                Второй                              =   Вес;
            КонецЕсли;
        КонецЦикла;
        Если
            Лидер > ДлинныеКолонки.Количество()
        Тогда
            Для Каждого Позиция
            Из          Затронутые
            Цикл
                Веса[Позиция]                       =   0;
            КонецЦикла;
            Возврат ?(Лидер = Второй, -1, ЛучшаяПозиция);
        КонецЕсли;
    КонецЕсли;
    //Полный подсчёт: обходим и длинные списки. Значение, которое есть во всех оставшихся строках,
    //добавляет всем по единице - его учитываем общим весом незатронутых, без обхода строк
    ВесНезатронутых                                 =   0;
    Для Каждого Колонка
    Из          ДлинныеКолонки
    Цикл
        Значение                                    =   СНайти[Колонка];
        Если
            ИскатьПоИндексу(Индекс, Колонка, Значение)
        Тогда
            Осталось                                =   Индекс.Осталось[Колонка][Значение];
            Если
                Осталось = Индекс.ОсталосьСтрок
            Тогда
                ВесНезатронутых                     =   ВесНезатронутых + 1;
                Продолжить;
            КонецЕсли;
            Для Каждого Позиция
            Из          Индекс.Позиции[Колонка][Значение]
            Цикл
                Если
                    Не Индекс.Исключена[Позиция]
                Тогда
                    ДобавитьВес(Веса, Позиция, Затронутые);
                КонецЕсли;
            КонецЦикла;
        Иначе
            Для Позиция = 0 По Индекс.Строки.ВГраница()
            Цикл
                Если
                    Не Индекс.Исключена[Позиция]
                И   ЗначенияРавныИЗаполнены(Значение, Индекс.Строки[Позиция][Колонка])
                Тогда
                    ДобавитьВес(Веса, Позиция, Затронутые);
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
    КонецЦикла;
    Возврат ВыбратьПоВесам(Индекс, Затронутые, ВесНезатронутых);
КонецФункции

Функция ЭтоИтерируемыйТип(Значение) Экспорт
    Перем ТипЗначения;
    ТипЗначения                                     =   ТипЗнч(Значение);
    Возврат     ТипЗначения = Тип("Массив")
            Или ТипЗначения = Тип("ТаблицаЗначений")
            Или ТипЗначения = Тип("СписокЗначений")
            Или ТипЗначения = Тип("Структура")
            Или ТипЗначения = Тип("Соответствие");
КонецФункции

Процедура ЛогИ_ОбъектПередЗаписью(Источник, Отказ) Экспорт
    Если
        Не ЕстьПользователь()
    Тогда
        Возврат;
    КонецЕсли;
    Событие                                         =   "Лог. Изменение Данных";
    Если
        Не Отказ
    Тогда
        Попытка
            ЧтоИзменилось                           =   "";
            СтарыйОбъект                            =   ?(ЕстьСвойство(Источник.ЭтотОбъект,"Ссылка"),Источник.ЭтотОбъект.Ссылка, Источник.ЭтотОбъект);
            НовыйОбъект                             =   Источник.ЭтотОбъект;
            ТипИсточника                            =   ТипЗнч(Источник);
            Если
                СтрНачинаетсяС(ТипИсточника, "Документ")
            Тогда
                Реквизиты                           =   ЗначенияСвойствДокумента(Источник);
            ИначеЕсли
                СтрНачинаетсяС(ТипИсточника, "Справочник")
            Тогда
                Реквизиты                           =   ЗначенияСвойствСправочника(Источник);
            ИначеЕсли
                СтрНачинаетсяС(ТипИсточника, "План видов расчета объект")
            Тогда
                Реквизиты                           =   ЗначенияСвойствСправочника(Источник);
            КонецЕсли;
            Если
                ЭтоИтерируемыйТип(Реквизиты)
            Тогда
                Для Каждого Реквизит
                Из          Реквизиты
                Цикл
                    Если
                        НЕ СтарыйОбъект[Реквизит] = НовыйОбъект[Реквизит]
                    Тогда
                        Если
                            ЗначениеЗаполнено(СтарыйОбъект[Реквизит])
                        Тогда
                            НовыйРеквизит           =   Строка(НовыйОбъект[Реквизит]);
                            ЧтоИзменилось           =   ЧтоИзменилось + "Реквизит " + Строка(Реквизит)
                                                    +   " изменился с " + Строка(СтарыйОбъект[Реквизит])
                                                    +   " на " + ?(ЗначениеЗаполнено(НовыйРеквизит), НовыйРеквизит, "пустое значение") + Символы.ПС;
                        Иначе
                            НовыйРеквизит           =   Строка(НовыйОбъект[Реквизит]);
                            Если
                                ЗначениеЗаполнено(НовыйРеквизит)
                            Тогда
                                ЧтоИзменилось       =   ЧтоИзменилось + "Установлено новое значение Реквизита " + Строка(Реквизит)
                                                    +   " = " + НовыйРеквизит + Символы.ПС;
                            КонецЕсли;
                        КонецЕсли;
                    КонецЕсли;
                КонецЦикла;
            КонецЕсли;
            Если
                ЕстьСвойство(Источник.ЭтотОбъект.Метаданные(), "ТабличныеЧасти")
            Тогда
                Для Каждого ТабличнаяЧасть
                Из          Источник.ЭтотОбъект.Метаданные().ТабличныеЧасти
                Цикл
                    СтараяТЧ                        =   СтарыйОбъект[ТабличнаяЧасть.Имя].Выгрузить();
                    НоваяТЧ                         =   НовыйОбъект[ТабличнаяЧасть.Имя].Выгрузить();
                    Если
                        Не (0   = СтараяТЧ.Количество()
                            И 0 = НоваяТЧ.Количество())
                    Тогда
                        ЧтоИзменилось               =   ЧтоИзменилось + ПолучитьИзмененияТЧ(СтараяТЧ, НоваяТЧ, ТабличнаяЧасть.Имя);
                    КонецЕсли;
                КонецЦикла;
            КонецЕсли;
            ЗаписатьИзменения(ЧтоИзменилось, Источник);
        Исключение
            Ошибка                                  =   ИнформацияОбОшибке();
            ОбработатьОшибку(Ошибка, Источник, ЧтоИзменилось);
        КонецПопытки;
    КонецЕсли;
КонецПроцедуры

Процедура ЛогИ_ДокументПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
    ЛогИ_ОбъектПередЗаписью(Источник, Отказ);
    Если
        Не РежимЗаписи = РежимЗаписиДокумента.Запись
    Тогда
        ЗаписатьИзменения(Строка(РежимЗаписи), Источник);
    КонецЕсли;
КонецПроцедуры

Функция ЗначенияСвойствРегистра(Регистр)
    МассивСвойств                                   =   Новый Массив();
    Для Каждого Измерение
    Из          Регистр.Метаданные().Измерения
    Цикл
        МассивСвойств.Добавить(Измерение.Имя)
    КонецЦикла;
    Для Каждого Измерение
    Из          Регистр.Метаданные().СтандартныеРеквизиты
    Цикл
        Если Не Измерение.Имя = "НомерСтроки" Тогда
            МассивСвойств.Добавить(Измерение.Имя);
        КонецЕсли;
    КонецЦикла;
    Для Каждого Измерение
    Из          Регистр.Метаданные().Ресурсы
    Цикл
        МассивСвойств.Добавить(Измерение.Имя)
    КонецЦикла;
    Для Каждого Измерение
    Из          Регистр.Метаданные().Реквизиты
    Цикл
        МассивСвойств.Добавить(Измерение.Имя)
    КонецЦикла;
    Возврат МассивСвойств;
КонецФункции

Функция ЗначенияСвойствСправочника(Источник)
    МассивСвойств                                   =   Новый Массив();
    Для Каждого Реквизит
    Из          Источник.ЭтотОбъект.Метаданные().Реквизиты
    Цикл
        МассивСвойств.Добавить(Реквизит.Имя);
    КонецЦикла;
    Для Каждого Реквизит
    Из          Источник.ЭтотОбъект.Метаданные().СтандартныеРеквизиты
    Цикл
        МассивСвойств.Добавить(Реквизит.Имя);
    КонецЦикла;
    Возврат МассивСвойств;
КонецФункции

Функция ЗначенияСвойствДокумента(Источник)
    МассивСвойств                                   =   Новый Массив();
    Для Каждого Реквизит
    Из          Источник.ЭтотОбъект.Метаданные().Реквизиты
    Цикл
        МассивСвойств.Добавить(Реквизит.Имя);
    КонецЦикла;
    Для Каждого Реквизит
    Из          Источник.ЭтотОбъект.Метаданные().СтандартныеРеквизиты
    Цикл
        МассивСвойств.Добавить(Реквизит.Имя);
    КонецЦикла;
    Возврат МассивСвойств;
КонецФункции

Функция ПолучитьНовыеСвойствРегистра(Регистр, Префикс="Новый элемент регистра ")
    Если
        Регистр.ЭтотОбъект.Количество()
    Тогда
        //Текст собираем в массив: сложение строк в цикле на наборе в тысячи записей занимает секунды
        Части                                       =   Новый Массив;
        Части.Добавить(Префикс + Символы.ПС);
        Свойства                                    =   ЗначенияСвойствРегистра(Регистр);
        Для Каждого Элемент
        Из          Регистр.ЭтотОбъект
        Цикл
            Для Каждого Свойство
            Из          Свойства
            Цикл
                Попытка
                    ЗначениеЭлемента                =   Строка(Элемент[Свойство]);
                    Если
                        ЗначениеЗаполнено(ЗначениеЭлемента)
                    Тогда
                        Части.Добавить(Свойство + " = " + ЗначениеЭлемента + Символы.ПС);
                    КонецЕсли;
                Исключение
                    Ошибка                          =   ИнформацияОбОшибке();
                    Части.Добавить(ОбработатьОшибку(Ошибка, Регистр, СтрСоединить(Части)));
                КонецПопытки;
            КонецЦикла;
        КонецЦикла;
        Возврат СтрСоединить(Части)
    Иначе
        Возврат ""
    КонецЕсли;
КонецФункции

Функция ПолучитьИзменениеСвойствРегистра(НРегистр, СТРегистр)
    ВернутьТекст                                    =   "";
    Если
        НРегистр.Количество() > СТРегистр.Количество()
    Тогда
        ВернутьТекст                                =   ПолучитьНовыеСвойствРегистра(НРегистр, "Добавлена запись регистра");
    ИначеЕсли
        НРегистр.Количество() < СТРегистр.Количество()
    Тогда
        ВернутьТекст                                =   ПолучитьНовыеСвойствРегистра(СТРегистр, "Удалена запись регистра");
    ИначеЕсли
        НРегистр.Количество() > 0
    Тогда
        Части                                       =   Новый Массив;
        Свойства                                    =   ЗначенияСвойствРегистра(НРегистр);
        Для I=0
        По  НРегистр.Количество()-1
        Цикл
            Для Каждого Свойство
            Из          Свойства
            Цикл
                Если
                    Не НРегистр[I][Свойство] = СТРегистр[I][Свойство]
                Тогда
                    Части.Добавить("Реквизит " + Свойство + " изменился с " + СТРегистр[I][Свойство] + " на "
                                                    +   ?(ЗначениеЗаполнено(НРегистр[I][Свойство]), НРегистр[I][Свойство], "пустое значение") + Символы.ПС);
                КонецЕсли;
            КонецЦикла;
        КонецЦикла;
        ВернутьТекст                                =   СтрСоединить(Части);
    КонецЕсли;
    Возврат ВернутьТекст
КонецФункции

Процедура ЛогИ_РегистрПередЗаписью(Источник, Отказ, Замещение) Экспорт
    Если
        Не ЕстьПользователь()
    Тогда
        Возврат;
    КонецЕсли;
    Если
        Не Отказ
    Тогда
        Событие                                     =   "Лог. Изменение Регистров";
        Попытка
            Если
                Замещение
            Тогда
                ЧтоИзменилось                       =   "";
                НовыйОбъект                         =   Источник.ЭтотОбъект;
                Если
                    СтрНайти(Тип(Источник), "Регистр накопления")>0
                Тогда
                    Регистр                         =   РегистрыНакопления[Источник.ЭтотОбъект.Метаданные().Имя].СоздатьНаборЗаписей();
                ИначеЕсли
                    СтрНайти(Тип(Источник), "Регистр сведений")>0
                Тогда
                    Регистр                         =   РегистрыСведений[Источник.ЭтотОбъект.Метаданные().Имя].СоздатьНаборЗаписей();
                КонецЕсли;
                Если
                    Не Неопределено = Регистр
                Тогда
                    Для Каждого ЭлементОтбора
                    Из          НовыйОбъект.Отбор
                    Цикл
                        Регистр.Отбор[ЭлементОтбора.Имя].Установить(ЭлементОтбора.Значение);
                    КонецЦикла;
                    Регистр.Прочитать();
                    Если
                        Регистр.ЭтотОбъект.Количество() = 0
                    Тогда
                        ЧтоИзменилось               =   ПолучитьНовыеСвойствРегистра(Источник.ЭтотОбъект);
                    Иначе
                        ЧтоИзменилось               =   ПолучитьИзменениеСвойствРегистра(Источник.ЭтотОбъект, Регистр.ЭтотОбъект);
                    КонецЕсли
                КонецЕсли;
            Иначе
                ЧтоИзменилось                       =   ПолучитьНовыеСвойствРегистра(Источник.ЭтотОбъект);
            КонецЕсли;
            ЗаписатьИзменения(ЧтоИзменилось, Источник);
        Исключение
            Ошибка                                  =   ИнформацияОбОшибке();
            ОбработатьОшибку(Ошибка, Источник, ЧтоИзменилось);
        КонецПопытки;
    КонецЕсли;
КонецПроцедуры

Процедура ЛогИ_РегистрРасчетаНаборЗаписейПередЗаписью(Источник, Отказ, Замещение, ТолькоЗапись, ЗаписьФактическогоПериодаДействия, ЗаписьПерерасчетов) Экспорт
    ЛогИ_РегистрПередЗаписью(Источник, Отказ, Замещение);
КонецПроцедуры

Процедура ЛогИ_КонстантаМенеджерЗначенияПередЗаписью(Источник, Отказ) Экспорт
    Событие                                         =   "Лог. Изменение Данных";
    Попытка
        Если
            Не ЕстьПользователь()
        Тогда
            Возврат;
        КонецЕсли;
        Если
            Не Отказ
        Тогда
            ЧтоИзменилось                           =   "";
            Попытка
                ЧтоИзменилось                       =   "Значение изменилось с " + Строка(Константы[Источник.Метаданные().Имя].Получить())
                                                    +   " на " + Строка(Источник.Значение);
                ЗаписатьИзменения(ЧтоИзменилось, Источник);
            Исключение
                Ошибка                              =   ИнформацияОбОшибке();
                ОбработатьОшибку(Ошибка, Источник, ЧтоИзменилось);
            КонецПопытки;
        КонецЕсли;
    Исключение
        Ошибка                                      =   ИнформацияОбОшибке();
        ОбработатьОшибку(Ошибка, Источник, ЧтоИзменилось);
    КонецПопытки;
КонецПроцедуры

